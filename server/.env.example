# Local-only example. Copy to server/.env and replace values; never commit secrets.
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER/?retryWrites=true&w=majority
MONGODB_DATABASE=insightboard_v2
MONGODB_AUTH_SOURCE=admin
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h
MAX_REPORTS_PER_USER=20
