# Local-only example. Copy to server/.env and replace values; never commit secrets.
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER/?retryWrites=true&w=majority
MONGODB_DATABASE=insightboard_v2
MONGODB_AUTH_SOURCE=admin
# Conservative, per-process pool defaults; increase only after measuring database demand.
MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h
MAX_REPORTS_PER_USER=20
GEMINI_API_KEY=add_your_private_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional owner-backed public Gnani mode. Personal-key BYOK ignores this variable.
# Shared mode is limited to 10 requests/IP/UTC day and 25 site-wide requests/UTC day.
GNANI_API_KEY=add_your_private_gnani_api_key_here
GNANI_SITE_DAILY_GLOBAL_LIMIT=25
