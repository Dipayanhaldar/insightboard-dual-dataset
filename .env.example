# Browser-safe Supabase project values only.
# Copy to .env.local on your computer; do not commit .env.local.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Keep GEMINI_API_KEY as a Supabase Edge Function secret, never in VITE_*.
# Optional Edge Function model override; default is gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
