{
  "name": "insightboard-vdb",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "NODE_ENV=production node server/index.js",
    "dev:api": "node --watch server/index.js",
    "check:server": "node --check server/index.js",
    "check:python": "python3 -m py_compile python_backend/app.py",
    "lint": "node --check server/index.js",
    "test": "node --test server/*.test.js src/v2/*.test.js",
    "check:pwa": "node scripts/validate-pwa.mjs",
    "check:pwa:build": "node scripts/validate-pwa-build.mjs"
  },
  "dependencies": {
    "@google/genai": ">=1.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "eslint": ">=9.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^13.2.0",
    "helmet": "^8.0.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "description": "InsightBoard VDB (Visual Dashboard) v2.1.0 — Enterprise Shopping Mall, Retail Sales & Schema-Aware Business Intelligence Platform",
  "engines": {
    "node": ">=20"
  }
}
