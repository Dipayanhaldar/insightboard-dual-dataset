{
  "id": "/",
  "name": "InsightBoard VDB",
  "short_name": "InsightBoard VDB",
  "description": "Explore, compare and understand datasets with InsightBoard VDB.",
  "lang": "en-IN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#123b67",
  "background_color": "#f5f8fc",
  "categories": [
    "business",
    "productivity",
    "education"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/insightboard-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/insightboard-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/insightboard.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "/?launch=file",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      },
      "icons": [
        {
          "src": "/icons/insightboard-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "shortcuts": [
    {
      "name": "Open Dashboard",
      "short_name": "Dashboard",
      "description": "Open the InsightBoard VDB workspace",
      "url": "/"
    },
    {
      "name": "Compare Datasets",
      "short_name": "Compare",
      "description": "Compare datasets in InsightBoard VDB",
      "url": "/#dataset-compare"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
