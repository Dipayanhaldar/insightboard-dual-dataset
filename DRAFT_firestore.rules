rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Blueprint Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'plan', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'plan', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.plan is string
        && data.plan.size() == 4
        && data.plan == 'free'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedReport(data) {
      return data.keys().hasAll(['ownerId', 'title', 'datasetName', 'recordCount', 'summary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'datasetName', 'recordCount', 'summary', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.datasetName is string
        && data.datasetName.size() >= 1
        && data.datasetName.size() <= 140
        && data.recordCount is int
        && data.recordCount >= 0
        && data.recordCount <= 10000000
        && data.summary is string
        && data.summary.size() >= 0
        && data.summary.size() <= 8000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Profiles Collection (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidUserProfile(incoming())
        && isOwner(userId)
        && isValidId(userId)
        && incoming().uid == existing().uid
        && incoming().plan == existing().plan
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;
    }

    // Saved Reports Collection (/reports/{reportId})
    match /reports/{reportId} {
      allow get: if isSignedIn()
        && isValidId(reportId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidSavedReport(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidSavedReport(incoming())
        && isValidId(reportId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(reportId)
        && existing().ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
  }
}
